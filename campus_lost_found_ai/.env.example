# Core
SECRET_KEY=replace-with-a-long-random-secret
FLASK_DEBUG=0
MAX_UPLOAD_MB=8

# Database: leave blank for local SQLite. For production use PostgreSQL.
DATABASE_URL=
SQLITE_DB=campus.db

# Admin dashboard
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password

# AI
AI_DEVICE=cpu
CLIP_MODEL=ViT-B-32
CLIP_PRETRAINED=laion2b_s34b_b79k
AI_FALLBACK=0

# Production image storage (recommended). Leave blank to use local static/uploads.
# CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
