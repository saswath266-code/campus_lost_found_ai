# Application
APP_ENV=development
FLASK_DEBUG=0
SECRET_KEY=replace-with-a-long-random-value
MAX_UPLOAD_MB=8
MAX_GEMINI_CANDIDATES=5

# MySQL (required)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=campus_lost_found
MYSQL_USER=root
MYSQL_PASSWORD=replace-with-your-mysql-password
MYSQL_CONNECT_TIMEOUT=8

# Gemini multimodal matching (optional locally; required for photo evidence)
GEMINI_API_KEY=replace-with-your-gemini-api-key
GEMINI_MODEL=gemini-3.6-flash

# Office dashboard (required to sign in to /admin)
ADMIN_USERNAME=nah
ADMIN_PASSWORD=nah

# Image storage. Leave blank for local static/uploads during development.
# Render's filesystem is ephemeral, so configure Cloudinary for deployed uploads.
CLOUDINARY_URL=
# Comma-separated exact hosts that stored cloud images may be fetched from for Gemini analysis.
CLOUDINARY_ALLOWED_HOSTS=res.cloudinary.com
